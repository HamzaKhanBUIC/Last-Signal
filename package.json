{
  "name": "the-last-signal",
  "version": "1.0.0",
  "description": "Atmospheric 2D Sci-Fi Survival Horror Browser Game",
  "main": "src/main.js",
  "type": "module",
  "scripts": {
    "test": "node tests/test-runner.js",
    "serve": "node -e \"const http=require('http'),fs=require('fs'),path=require('path');const port=3000;const mime={'html':'text/html','js':'application/javascript','css':'text/css','json':'application/json','png':'image/png','wav':'audio/wav'};http.createServer((req,res)=>{let f=path.join(__dirname,req.url==='/'?'index.html':req.url.split('?')[0]);fs.readFile(f,(err,data)=>{if(err){res.writeHead(404);res.end('Not found');}else{let ext=path.extname(f).slice(1);res.writeHead(200,{'Content-Type':mime[ext]||'text/plain'});res.end(data);}});}).listen(port,()=>console.log('Running on http://localhost:'+port));\""
  },
  "keywords": [
    "game",
    "canvas",
    "horror",
    "procedural-audio",
    "raycasting",
    "ai"
  ],
  "author": "Antigravity Multi-Agent Team",
  "license": "MIT",
  "dependencies": {
    "three": "^0.185.1"
  }
}
